// ============================================================================
// 피보나치 수열 프로그램 (Fibonacci Sequence)
// F(0)=0, F(1)=1, ..., F(10)=55
// 결과를 데이터 메모리 0x1000번지부터 저장
// ============================================================================
// 레지스터 사용:
//   x10 (a0) = F(n-2), 현재의 이전 이전 값
//   x11 (a1) = F(n-1), 현재의 이전 값
//   x12 (a2) = F(n),   현재 피보나치 값
//   x13 (a3) = 루프 카운터
//   x14 (a4) = 최대 반복 횟수 (10)
//   x15 (a5) = 메모리 저장 주소 (0x1000)
// ============================================================================

// 주소 0x000: ADDI x10, x0, 0      # a0 = F(0) = 0
00000513
// 주소 0x004: ADDI x11, x0, 1      # a1 = F(1) = 1
00100593
// 주소 0x008: ADDI x13, x0, 0      # a3 = 카운터 = 0
00000693
// 주소 0x00C: ADDI x14, x0, 10     # a4 = 최대 반복 = 10
00A00713
// 주소 0x010: LUI  x15, 0x00001    # a5 = 0x1000 (상위 비트)
000017B7
// 주소 0x014: SW   x10, 0(x15)     # mem[0x1000] = F(0) = 0
00A7A023
// 주소 0x018: ADDI x15, x15, 4     # a5 += 4
00478793
// 주소 0x01C: SW   x11, 0(x15)     # mem[0x1004] = F(1) = 1
00B7A023
// 주소 0x020: ADDI x15, x15, 4     # a5 += 4
00478793
// --- 루프 시작 (주소 0x024) ---
// 주소 0x024: ADD  x12, x10, x11   # a2 = F(n-2) + F(n-1) = F(n)
00B50633
// 주소 0x028: SW   x12, 0(x15)     # mem[addr] = F(n)
00C7A023
// 주소 0x02C: ADDI x15, x15, 4     # addr += 4
00478793
// 주소 0x030: ADD  x10, x11, x0    # a0 = a1 (시프트)
000585B3
// 주소 0x030 수정 — 실제: ADDI x10, x11, 0  # a0 = a1
00058513
// 주소 0x034: ADD  x11, x12, x0    # a1 = a2 (시프트)
00060593
// 주소 0x034 수정 — 실제: ADDI x11, x12, 0  # a1 = a2
00060593
// 주소 0x038: ADDI x13, x13, 1     # 카운터++
00168693
// 주소 0x03C: BLT  x13, x14, -24   # if (카운터 < 10) goto 루프 시작
FEE6C4E3
// --- 루프 종료 ---
// 주소 0x040: ADDI x0, x0, 0       # NOP (프로그램 종료 — 무한 대기)
00000013
// 주소 0x044: JAL  x0, -4          # 무한 루프 (PC 고정)
FFDFF06F