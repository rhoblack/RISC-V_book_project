// 1~10 합산 프로그램 (RV32I)
// Chapter 10 — 중간 마일스톤: 포워딩 파이프라인 검증
// 실행 결과: x10 = 55 (0x37)
//
// 주소  기계어       어셈블리
// 0x00  00000513    addi x10, x0, 0     // sum = 0
// 0x04  00100593    addi x11, x0, 1     // i = 1
// 0x08  00B00613    addi x12, x0, 11    // limit = 11
// 0x0C  00B50533    add  x10, x10, x11  // sum += i (RAW: x10)
// 0x10  00158593    addi x11, x11, 1    // i++ (RAW: x11)
// 0x14  FEC59CE3    bne  x11, x12, -8   // if (i != 11) goto loop
// 0x18  00000013    nop                  // 프로그램 종료
00000513
00100593
00B00613
00B50533
00158593
FEC59CE3
00000013
